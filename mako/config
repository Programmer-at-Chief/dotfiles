# default theme for Mako notification daemon

# Layout
max-visible=5
layer=overlay
anchor=top-right
margin=8
width=260
height=90

# Styling
background-color=#1e1e2ee6
text-color=#cdd6f4
border-color=#45475a
border-size=1
border-radius=10
padding=10

# Font
font=DejaVu Sans 10

# Icons
max-icon-size=48
icon-path=/usr/share/icons/Adwaita

# Timing
default-timeout=4000
ignore-timeout=1

# History
max-history=50

# Grouping
group-by=app-name

# Urgency levels

[urgency=low]
background-color=#1e1e2ecc
text-color=#6c7086
border-color=#585b70
default-timeout=2500

[urgency=normal]
background-color=#1e1e2ee6
text-color=#cdd6f4
border-color=#89b4fa
default-timeout=5000

[urgency=critical]
background-color=#1e1e2eff
text-color=#f38ba8
border-color=#f38ba8
border-size=2
default-timeout=0

# Do Not Disturb
[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb app-name=notify-send]
invisible=0

# Brightness notifications
[app-name=brightness]
anchor=top-center
layer=overlay

width=320
height=80

margin=12
padding=14

background-color=#1e1e2eee
text-color=#0d0000ff

border-size=1
border-color=#313244ff
border-radius=14

progress-color=#FF788D

icons=1
max-icon-size=32
icon-location=left

format=<b>%s</b>\n%b

font=JetBrainsMono Nerd Font 11

default-timeout=1000
